# Proveedor principal y de respaldo (si el principal se cae, se usa el otro).
LLM_PROVIDER=anthropic
LLM_FALLBACK_PROVIDER=openai

ANTHROPIC_API_KEY=tu_clave_anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=tu_clave_openai
OPENAI_MODEL=gpt-4o-mini

# Opcionales: reintentos del SDK antes de pasar al respaldo y timeout en segundos.
LLM_MAX_RETRIES=2
LLM_TIMEOUT=60

# Pre-entrega 2 (opcionales): tokens maximos de la respuesta del pipeline e
# intentos totales de la cadena ante JSON mal formado o incompleto (minimo 2).
PIPELINE_MAX_TOKENS=1024
PIPELINE_MAX_INTENTOS=3

# Pre-entrega 3 (RAG). Las claves de arriba se reutilizan: los embeddings usan
# OPENAI_API_KEY (Anthropic no ofrece embeddings), asi que es obligatoria.
# IMPORTANTE: si cambias EMBEDDINGS_MODEL hay que re-indexar (ingesta.py lo
# detecta y lo hace solo; consultar con otro modelo da error a proposito).
EMBEDDINGS_MODEL=text-embedding-3-small
# Fragmentos recuperados por pregunta (entre 3 y 5).
RAG_TOP_K=4
# Tamano de fragmento en tokens (minimo 500) y solapamiento (minimo 50).
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=50
